---
const pageTitle = "AI Workflow Team Scoreboard";
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <style is:global>
      :root {
        color-scheme: dark;
        --bg: #09111f;
        --panel: #111b2c;
        --panel-2: #162236;
        --line: #273852;
        --text: #f4f7fb;
        --muted: #94a3b8;
        --blue: #5aa7ff;
        --cyan: #44d7d0;
        --green: #7bd88f;
        --yellow: #f4d35e;
        --red: #ff7a7a;
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        min-height: 100vh;
        background:
          radial-gradient(circle at top left, rgba(68, 215, 208, 0.14), transparent 34rem),
          linear-gradient(160deg, #09111f 0%, #111827 52%, #0d1324 100%);
        color: var(--text);
        font-family: "Noto Sans KR", "Apple SD Gothic Neo", system-ui, sans-serif;
      }

      button, input { font: inherit; }
      button { border: 0; cursor: pointer; }

      .shell {
        width: min(1440px, calc(100vw - 40px));
        margin: 0 auto;
        padding: 40px 0 56px;
      }

      .brandbar {
        display: flex;
        gap: 18px;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 28px;
        padding: 14px 16px;
        border: 1px solid rgba(90, 167, 255, 0.24);
        border-radius: 8px;
        background: rgba(17, 27, 44, 0.74);
      }

      .brand-copy strong { display: block; font-size: 18px; }
      .brand-copy span { display: block; margin-top: 3px; color: #b8c5d8; font-size: 13px; }

      .brand-badge {
        display: inline-flex;
        align-items: center;
        min-height: 34px;
        padding: 0 12px;
        border: 1px solid rgba(68, 215, 208, 0.36);
        border-radius: 999px;
        background: rgba(68, 215, 208, 0.1);
        color: #c7fffb;
        font-size: 13px;
        font-weight: 900;
        white-space: nowrap;
      }

      .hero {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 24px;
        align-items: end;
        padding-bottom: 28px;
        border-bottom: 1px solid var(--line);
      }

      .eyebrow { margin: 0 0 10px; color: var(--cyan); font-size: 14px; font-weight: 700; }
      h1 { margin: 0; font-size: clamp(34px, 4vw, 64px); line-height: 1.05; letter-spacing: 0; }
      h2, h3 { margin: 0; letter-spacing: 0; }
      .hero p { max-width: 780px; margin: 18px 0 0; color: #cbd5e1; font-size: 18px; line-height: 1.7; }

      .actions { display: flex; gap: 10px; align-items: center; justify-content: flex-end; flex-wrap: wrap; }

      .button {
        min-height: 44px;
        padding: 0 18px;
        border-radius: 8px;
        background: var(--blue);
        color: #06101f;
        font-weight: 800;
      }

      .button.secondary {
        border: 1px solid var(--line);
        background: rgba(255, 255, 255, 0.06);
        color: var(--text);
      }

      .status, .auto-refresh { color: var(--muted); font-size: 14px; }

      .summary {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 12px;
        margin: 24px 0;
      }

      .metric, .team-card, .rules-toggle, .admin-panel {
        border: 1px solid rgba(148, 163, 184, 0.18);
        border-radius: 8px;
        background: rgba(17, 27, 44, 0.76);
      }

      .metric { padding: 16px; }
      .metric span { display: block; color: var(--muted); font-size: 13px; }
      .metric strong { display: block; margin-top: 8px; font-size: 28px; }

      .scoreboard-head, .section-title, .admin-costs-head {
        display: flex;
        gap: 14px;
        align-items: end;
        justify-content: space-between;
        margin: 28px 0 14px;
      }

      .scoreboard-head p, .section-title p, .admin-costs-head p {
        margin: 6px 0 0;
        color: var(--muted);
        line-height: 1.6;
      }

      .score-chart {
        display: grid;
        gap: 10px;
        padding: 18px;
        border-radius: 8px;
        background: rgba(9, 17, 31, 0.45);
      }

      .bar-row {
        display: grid;
        grid-template-columns: 72px minmax(0, 1fr) 72px;
        gap: 12px;
        align-items: center;
      }

      .bar-track {
        height: 14px;
        overflow: hidden;
        border-radius: 999px;
        background: rgba(148, 163, 184, 0.16);
      }

      .bar-fill {
        height: 100%;
        border-radius: inherit;
        background: linear-gradient(90deg, var(--cyan), var(--blue));
      }

      .teams {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
      }

      .team-card { padding: 18px; }
      .team-top { display: flex; justify-content: space-between; gap: 12px; align-items: start; }
      .team-score { color: var(--cyan); font-size: 34px; font-weight: 900; }
      .team-repo { color: var(--muted); font-size: 13px; word-break: break-all; }
      .pill { display: inline-flex; border-radius: 999px; padding: 4px 9px; background: rgba(123, 216, 143, 0.14); color: #c8ffd3; font-size: 12px; font-weight: 800; }
      .pill.warning { background: rgba(244, 211, 94, 0.14); color: #ffe99a; }
      .pill.danger { background: rgba(255, 122, 122, 0.14); color: #ffc6c6; }

      .metric-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 8px;
        margin-top: 16px;
      }

      .mini { padding: 10px; border-radius: 8px; background: rgba(9, 17, 31, 0.46); }
      .mini span { display: block; color: var(--muted); font-size: 12px; }
      .mini strong { display: block; margin-top: 5px; }

      .members { display: grid; gap: 8px; margin-top: 16px; }
      .member { display: grid; grid-template-columns: 132px minmax(0, 1fr) 46px; gap: 10px; align-items: center; font-size: 13px; }

      .quality {
        margin-top: 16px;
        padding: 12px;
        border-radius: 8px;
        background: rgba(9, 17, 31, 0.46);
      }

      .quality p { margin: 8px 0 0; color: #cbd5e1; line-height: 1.55; }

      .admin-panel {
        display: none;
        margin-top: 22px;
        padding: 18px;
        border-color: rgba(90, 167, 255, 0.28);
      }

      .admin-panel.active { display: block; }
      .admin-form { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 10px; margin: 16px 0; }
      .input { min-height: 44px; width: 100%; border: 1px solid var(--line); border-radius: 8px; background: rgba(9, 17, 31, 0.72); color: var(--text); padding: 0 14px; }
      .admin-error { min-height: 20px; color: var(--yellow); font-size: 13px; }
      .admin-repos { display: grid; gap: 8px; }
      .admin-repo { display: flex; justify-content: space-between; gap: 10px; align-items: center; padding: 10px; border-radius: 8px; background: rgba(9, 17, 31, 0.46); }

      .rules-toggle { margin-top: 28px; padding: 16px; }
      .rules-toggle summary { cursor: pointer; font-weight: 900; }
      .rules { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin-top: 14px; }
      .rule { padding: 12px; border-radius: 8px; background: rgba(9, 17, 31, 0.46); }
      .rule p { margin: 8px 0 0; color: var(--muted); line-height: 1.55; }

      .notice, .empty {
        padding: 16px;
        border-radius: 8px;
        background: rgba(244, 211, 94, 0.1);
        color: #ffe99a;
      }

      .footer-brand {
        display: flex;
        justify-content: center;
        margin-top: 36px;
        color: var(--muted);
        font-size: 13px;
      }

      @media (max-width: 900px) {
        .hero, .teams, .summary, .rules, .metric-grid { grid-template-columns: 1fr; }
        .actions { justify-content: flex-start; }
        .admin-form { grid-template-columns: 1fr; }
      }
    </style>
  </head>
  <body>
    <main class="shell">
      <header class="brandbar" aria-label="NxtCloud 교육 운영 도구">
        <div class="brand-copy">
          <strong>NxtCloud</strong>
          <span>AI Workflow Classroom Operations</span>
        </div>
        <span class="brand-badge">NxtCloud 교육 운영 대시보드</span>
      </header>

      <section class="hero">
        <div>
          <p class="eyebrow">2026 국민대 AI Workflow</p>
          <h1>팀 PR 협업 점수판</h1>
          <p>
            1~5팀 public GitHub repo를 조회해 branch, commit, push, PR, 동료 review, merge 흐름을 계산합니다.
            원점수에 참여 균형과 품질 보정을 곱해 협업 사이클을 운영 관점으로 봅니다.
          </p>
        </div>
        <div class="actions">
          <button class="button secondary" id="admin-open" type="button">관리자 모드</button>
          <span class="status" id="status">대기 중</span>
        </div>
      </section>

      <div class="notice" id="notice" hidden></div>

      <section class="admin-panel" id="admin-panel">
        <div class="scoreboard-head">
          <div>
            <h2>관리자 모드</h2>
            <p>조회할 GitHub public repo 링크를 등록하거나 제거합니다. 전체 최신화는 관리자 세션에서만 실행합니다.</p>
          </div>
          <div class="actions">
            <button class="button" id="admin-refresh-all" type="button">전체 최신화</button>
            <button class="button secondary" id="admin-logout" type="button">관리자 종료</button>
          </div>
        </div>
        <form class="admin-form" id="admin-form">
          <input class="input" id="admin-repo-url" name="repoUrl" type="url" placeholder="https://github.com/nxtcloud-edu/2026-kookmin-ai-workflow-team1" autocomplete="off" />
          <button class="button" type="submit">repo 등록</button>
        </form>
        <div class="admin-error" id="admin-message"></div>
        <div class="admin-repos" id="admin-repos"></div>
      </section>

      <section class="summary" id="summary"></section>

      <section class="scoreboard">
        <div class="scoreboard-head">
          <div>
            <h2>팀별 점수 현황</h2>
            <p>보정점수 = 원점수 x 균형 보정 x 품질 보정입니다.</p>
          </div>
          <span class="auto-refresh" id="auto-refresh">5분마다 자동 최신화</span>
        </div>
        <div class="score-chart" id="score-chart">
          <div class="empty">아직 조회한 데이터가 없습니다.</div>
        </div>
      </section>

      <section>
        <div class="section-title">
          <div>
            <h2>팀별 점수</h2>
            <p>점수, 참여 균형, PR 흐름을 먼저 보고 필요할 때 세부 지표를 펼칩니다.</p>
          </div>
        </div>
        <div class="teams" id="teams">
          <div class="empty">아직 조회한 데이터가 없습니다.</div>
        </div>
      </section>

      <section class="rules-panel">
        <details class="rules-toggle">
          <summary>점수 기준 보기</summary>
          <div class="rules">
            <article class="rule"><b>PR 사이클 누적</b><p>PR open, merge, 동료 review/comment를 협업 사이클로 누적합니다.</p></article>
            <article class="rule"><b>커밋 점수 누적</b><p>팀원 계정으로 인식된 커밋을 작은 반복 훈련으로 반영합니다.</p></article>
            <article class="rule"><b>상호 검토 누적</b><p>자기 PR이 아닌 동료 PR에 남긴 review/comment를 반영합니다.</p></article>
            <article class="rule"><b>정리 점수</b><p>민감 파일 의심과 열린 PR 정리 상태를 확인합니다.</p></article>
            <article class="rule"><b>기여 균형</b><p>한 명에게 몰리지 않고 팀원 비중이 비슷할수록 보정이 올라갑니다.</p></article>
            <article class="rule"><b>품질 보정</b><p>리뷰 부족, 위험 변경, 메시지 모호성을 약한 보정과 라벨로 표시합니다.</p></article>
          </div>
        </details>
      </section>

      <footer class="footer-brand">NxtCloud Learning Ops · GitHub PR 협업 훈련 현황판</footer>
    </main>

    <div class="modal-backdrop" id="admin-modal" role="dialog" aria-modal="true" hidden>
      <form class="modal admin-panel active" id="admin-login-form">
        <h2>관리자 로그인</h2>
        <p>repo 등록과 삭제는 관리자만 할 수 있습니다.</p>
        <input class="input" id="admin-password" name="password" type="password" placeholder="관리자 비밀번호" autocomplete="current-password" />
        <div class="admin-error" id="admin-login-error"></div>
        <div class="actions">
          <button class="button secondary" id="admin-close" type="button">닫기</button>
          <button class="button" type="submit">로그인</button>
        </div>
      </form>
    </div>

    <script>
      const state = { snapshot: null, isAdmin: false };
      const statusEl = document.querySelector("#status");
      const summaryEl = document.querySelector("#summary");
      const chartEl = document.querySelector("#score-chart");
      const teamsEl = document.querySelector("#teams");
      const noticeEl = document.querySelector("#notice");
      const adminPanel = document.querySelector("#admin-panel");
      const adminModal = document.querySelector("#admin-modal");
      const adminRepos = document.querySelector("#admin-repos");
      const adminMessage = document.querySelector("#admin-message");

      document.querySelector("#admin-open").addEventListener("click", () => {
        if (state.isAdmin) {
          adminPanel.classList.toggle("active");
          return;
        }
        adminModal.hidden = false;
      });
      document.querySelector("#admin-close").addEventListener("click", () => { adminModal.hidden = true; });
      document.querySelector("#admin-refresh-all").addEventListener("click", () => loadScore({ force: true }));
      document.querySelector("#admin-logout").addEventListener("click", logoutAdmin);
      document.querySelector("#admin-login-form").addEventListener("submit", loginAdmin);
      document.querySelector("#admin-form").addEventListener("submit", addRepo);

      loadScore();
      setInterval(() => loadScore(), 5 * 60 * 1000);

      async function loadScore({ force = false } = {}) {
        statusEl.textContent = force ? "최신화 중" : "조회 중";
        try {
          const response = await fetch("/api/score.json", {
            method: force ? "POST" : "GET",
            headers: force ? { "content-type": "application/json" } : undefined,
            body: force ? "{}" : undefined
          });
          state.snapshot = await response.json();
          renderSnapshot(state.snapshot);
          statusEl.textContent = `업데이트 ${formatDate(state.snapshot.refreshedAt)}`;
        } catch (error) {
          statusEl.textContent = "조회 실패";
          showNotice(error.message);
        }
      }

      function renderSnapshot(snapshot) {
        const teams = [...(snapshot.teams ?? [])].sort((a, b) => (b.adjustedScore ?? b.score ?? 0) - (a.adjustedScore ?? a.score ?? 0));
        const maxScore = Math.max(1, ...teams.map((team) => team.adjustedScore ?? team.score ?? 0));
        renderSummary(snapshot.summary);
        chartEl.innerHTML = teams.map((team) => {
          const score = team.adjustedScore ?? team.score ?? 0;
          return `<div class="bar-row"><strong>${escapeHtml(team.label)}</strong><div class="bar-track"><div class="bar-fill" style="width:${Math.round(score / maxScore * 100)}%"></div></div><span>${score}</span></div>`;
        }).join("") || `<div class="empty">아직 조회한 데이터가 없습니다.</div>`;
        teamsEl.innerHTML = teams.map(renderTeam).join("") || `<div class="empty">아직 조회한 데이터가 없습니다.</div>`;
      }

      function renderSummary(summary = {}) {
        const items = [
          ["활성 팀", `${summary.activeTeams ?? 0} / ${summary.teamCount ?? 0}`],
          ["평균 점수", summary.averageScore ?? 0],
          ["총 커밋", summary.totalCommits ?? 0],
          ["총 PR", summary.totalPulls ?? 0],
          ["품질 경고", `${summary.qualityWarnings ?? 0} / ${summary.qualityLabels ?? 0}`]
        ];
        summaryEl.innerHTML = items.map(([label, value]) => `<div class="metric"><span>${label}</span><strong>${value}</strong></div>`).join("");
      }

      function renderTeam(team) {
        const metrics = team.metrics ?? {};
        const quality = team.quality ?? {};
        const statusClass = team.status === "확인 필요" ? "danger" : team.status === "편중" || team.status === "리뷰 부족" ? "warning" : "";
        return `
          <article class="team-card">
            <div class="team-top">
              <div>
                <h3>${escapeHtml(team.label)}</h3>
                <div class="team-repo">${escapeHtml(team.repo)}</div>
              </div>
              <div>
                <div class="team-score">${team.adjustedScore ?? team.score ?? 0}</div>
                <span class="pill ${statusClass}">${escapeHtml(team.status ?? "대기")}</span>
              </div>
            </div>
            <div class="metric-grid">
              ${mini("커밋", metrics.commits)}
              ${mini("PR", metrics.pulls)}
              ${mini("Merge", metrics.mergedPulls)}
              ${mini("동료검토", `${metrics.peerReviewCoverage ?? 0}%`)}
            </div>
            <div class="members">${(team.members ?? []).map(renderMember).join("")}</div>
            <div class="quality">
              <b>${escapeHtml(quality.status ?? "대기")}</b>
              <p>${escapeHtml(quality.summary ?? "품질 평가 정보가 없습니다.")}</p>
            </div>
          </article>
        `;
      }

      function mini(label, value = 0) {
        return `<div class="mini"><span>${label}</span><strong>${value}</strong></div>`;
      }

      function renderMember(member) {
        const share = Number(member.share ?? 0);
        return `<div class="member"><span>${escapeHtml(member.login)}</span><div class="bar-track"><div class="bar-fill" style="width:${share}%"></div></div><strong>${share}%</strong></div>`;
      }

      async function loginAdmin(event) {
        event.preventDefault();
        const password = new FormData(event.currentTarget).get("password");
        const response = await fetch("/api/admin/login.json", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ password })
        });
        const payload = await response.json();
        if (!payload.ok) {
          document.querySelector("#admin-login-error").textContent = payload.error ?? "로그인 실패";
          return;
        }
        state.isAdmin = true;
        adminModal.hidden = true;
        adminPanel.classList.add("active");
        await loadRepos();
      }

      async function logoutAdmin() {
        await fetch("/api/admin/logout.json", { method: "POST" });
        state.isAdmin = false;
        adminPanel.classList.remove("active");
      }

      async function loadRepos() {
        const response = await fetch("/api/admin/repos.json");
        const payload = await response.json();
        if (!payload.ok) {
          adminMessage.textContent = payload.error ?? "repo 조회 실패";
          return;
        }
        renderRepos(payload.repos ?? []);
      }

      async function addRepo(event) {
        event.preventDefault();
        const repoUrl = new FormData(event.currentTarget).get("repoUrl");
        const response = await fetch("/api/admin/repos.json", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ repoUrl })
        });
        const payload = await response.json();
        if (!payload.ok) {
          adminMessage.textContent = payload.error ?? "repo 등록 실패";
          return;
        }
        adminMessage.textContent = "";
        event.currentTarget.reset();
        renderRepos(payload.repos ?? []);
      }

      function renderRepos(repos) {
        adminRepos.innerHTML = repos.map((repo) => `<div class="admin-repo"><span>${escapeHtml(repo.repo)}</span><span>${escapeHtml(repo.source)}</span></div>`).join("");
      }

      function showNotice(message) {
        noticeEl.hidden = false;
        noticeEl.textContent = message;
      }

      function formatDate(value) {
        if (!value) return "대기";
        return new Intl.DateTimeFormat("ko-KR", { dateStyle: "short", timeStyle: "short" }).format(new Date(value));
      }

      function escapeHtml(value) {
        return String(value ?? "").replace(/[&<>"']/g, (char) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#039;" })[char]);
      }
    </script>
  </body>
</html>
